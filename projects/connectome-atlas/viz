#!/bin/sh
set -eu
VIZ_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export CUDA_VISIBLE_DEVICES="" MPLCONFIGDIR="$VIZ_DIR/cache/matplotlib"
export SQLITE_TMPDIR="$VIZ_DIR/cache/sqlite-temp"
mkdir -p "$SQLITE_TMPDIR"
export PYTHONPATH="$VIZ_DIR/src"
exec "$VIZ_DIR/.venv/bin/python" -B -m connectome_viz.cli "$@"
